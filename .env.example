# =============================================================================
# .env.example — MODELO de segredos (pode ir para o GitHub; NÃO tem valores reais)
# -----------------------------------------------------------------------------
# COMO USAR:
#   1. Copie para um arquivo chamado ".env":  Copy-Item .env.example .env
#   2. Preencha cada variável com os seus valores REAIS.
#   3. O ".env" é ignorado pelo .gitignore -> NUNCA vai para o GitHub.
# =============================================================================

# --- OpenAI (modelo gpt-3.5-turbo) ------------------------------------------
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque-sua-chave-openai-aqui

# --- Banco PostgreSQL: conexão PRINCIPAL (usuário postgres) ------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Usada para o checkpointer (memória) e para GRAVAR nas tabelas. postgres é
# superusuário -> ignora a RLS (é o "master").
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/agente_ia

# --- Banco PostgreSQL: conexão SÓ-LEITURA (usuário agente_leitura) -----------
# Usada pelo SQL toolkit dos usuários comuns. Respeita a RLS -> cada um só vê o
# seu. Crie esse usuário com sql/02_usuario_leitura.sql.
DATABASE_URL_RO=postgresql://agente_leitura:senha_leitura@localhost:5432/agente_ia

# --- LangSmith (observabilidade) — OPCIONAL ---------------------------------
# Sem código: com estas variáveis, o LangChain envia os traces para o painel.
# Pegue a chave em: https://smith.langchain.com/ (Settings).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=coloque-sua-chave-langsmith-aqui
LANGSMITH_PROJECT=agente-py-langchain

# --- Google Gemini — OPCIONAL (para trocar de modelo no futuro) -------------
# Pegue em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coloque-sua-chave-google-aqui
